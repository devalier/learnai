generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
}

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  name          String
  passwordHash  String
  role          Role            @default(STUDENT)
  /// Opt-in to social features (and to being visible to others on nodes).
  /// Off by default. Turning it off deletes the user's social data.
  presenceOptIn Boolean         @default(false)
  /// When the user confirmed they are 16 or older (self-declared, not verified).
  ageConfirmedAt  DateTime?
  termsAcceptedAt DateTime?
  termsVersion    String          @default("")
  /// Sessions issued before this are no longer valid (set when the password is reset).
  passwordChangedAt DateTime?
  /// Raised to sign out every device at once ("sign out of all devices", a password
  /// reset). A session token carries the version it was issued at and is refused if it differs.
  sessionVersion Int @default(0)
  /// Account metadata for housekeeping (finding abandoned accounts). No IP address and
  /// no device data is kept. lastSeenAt is written at most once an hour.
  lastLoginAt   DateTime?
  lastSeenAt    DateTime?
  loginCount    Int             @default(0)
  createdAt     DateTime        @default(now())
  consents      ConsentRecord[]
  questions     Question[]
  answers       Answer[]
  votes         Vote[]
  reviews       AnswerReview[]
  answerAppeals AnswerAppeal[]
  quizAppeals   QuizQuestionAppeal[]
  quizzes       Quiz[]
  quizAttempts  QuizAttempt[]
  quizRatings   QuizRating[]
  quizReviews   QuizQuestionReview[]
  stakes        Stake[]
  expansions    Expansion[]
  passwordResets PasswordReset[]
  reports       Report[]
  resourceVotes ResourceVote[]
  progress      Progress[]
  worksheets    WorksheetEntry[]
  holdings      Holding[]
  claimsOpened  Claim[]
  claimPositions ClaimPosition[]
}

model Course {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  subtitle    String    @default("")
  description String    @default("")
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  sections    Section[]
}

model Section {
  id       String   @id @default(cuid())
  courseId String
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title    String
  subtitle String   @default("")
  kicker   String   @default("")
  order    Int      @default(0)
  modules  Module[]
}

model Module {
  id           String     @id @default(cuid())
  sectionId    String
  section      Section    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  code         String     @default("")
  title        String
  topic        String     @default("") @map("stanfordWeek")
  timeSlot     String     @default("")
  duration     String     @default("")
  summary      String     @default("")
  body         String     @default("")
  order        Int        @default(0)
  /// CORE counts toward the course percentage; OPTIONAL and REFERENCE stay visible and
  /// tickable but are outside it. Changing a tier never touches Progress rows.
  tier         String     @default("CORE")
  resources    Resource[]
  progress     Progress[]
}

model Resource {
  id          String     @id @default(cuid())
  moduleId    String
  module      Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  type        String     @default("VIDEO")
  title       String
  url         String     @default("")
  author      String     @default("")
  durationMin Int?
  note        String     @default("")
  order       Int        @default(0)
  progress    Progress[]
  coverage    Coverage[]
  votes       ResourceVote[]
}

model Progress {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId   String?
  module     Module?   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  resourceId String?
  resource   Resource? @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  completed  Boolean   @default(true)
  /// How the completion was established. Rows that existed before this column are
  /// LEGACY_SELF_REPORTED: a tick, never evidence of understanding. Nothing upgrades a
  /// row to a verified basis except a future assessment that records its own evidence.
  basis      String    @default("SELF_REPORTED")
  updatedAt  DateTime  @updatedAt

  @@unique([userId, moduleId])
  @@unique([userId, resourceId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Lattice knowledge graph (added alongside The List; The List is unchanged).
// A shared, multi-user graph: everyone reads the same Node/Edge/Region set;
// each user has their own Holding rows and Claim positions. See README.
// ─────────────────────────────────────────────────────────────────────────────

enum NodeKind {
  CONCEPT
  DECISION
  CONSTRAINT
}

enum EdgeKind {
  REFINES
  ADJACENT
  TENSION
}

enum HoldingState {
  HELD
  THIN
}

enum ClaimState {
  OPEN
}

enum Stance {
  FOR
  AGAINST
}

/// How deeply a resource treats a node. Ordered weakest to strongest coverage.
enum CoverageDepth {
  MENTIONS
  DEMONSTRATES
  DEFINES
}

/// Where a coverage row came from. SEED is hand-authored in prisma/seed.ts,
/// MACHINE is transcript extraction, HUMAN is an admin's review decision.
enum CoverageSource {
  SEED
  MACHINE
  HUMAN
}

/// A wayfinding label over a cluster of nodes. A region is NOT knowledge and is
/// never holdable: there is no Holding relation here on purpose. "I hold ground
/// on Foundations" is not a defensible sentence; "on supervised learning" is.
model Region {
  id     String @id @default(cuid())
  slug   String @unique
  name   String
  blurb  String @default("")
  labelX Float  @default(0)
  labelY Float  @default(0)
  order  Int    @default(0)
  nodes  Node[]
}

/// One idea a practitioner can be wrong about. Not a lesson, and not a shelf.
///
/// A node names a *space* you can hold a position in, under four rules: the
/// title is the thing and not the contrast (AGI, not "ANI vs AGI"); it is
/// canonical outside this course; it is one to three words with no preposition;
/// and it is a space, not a fact (a fact belongs in a body, a whole field
/// belongs in a Region).
///
/// The body is three parts, because that is what makes a holding defensible:
/// what it means, what people get wrong, and how you defend it.
model Node {
  id             String     @id @default(cuid())
  slug           String     @unique
  title          String
  summary        String     @default("")
  whatItMeans    String     @default("")
  commonlyWrong  String     @default("")
  howToDefend    String     @default("")
  kind           NodeKind   @default(CONCEPT)
  regionId       String?
  region         Region?    @relation(fields: [regionId], references: [id], onDelete: SetNull)
  contentVersion Int        @default(1)
  material       Boolean    @default(false)
  x              Float      @default(0)
  y              Float      @default(0)
  retiredAt      DateTime?
  /// SEED = from the curated vocabulary or the admin console; COMMUNITY = added by
  /// an AI-validated expert suggestion. The seed never retires COMMUNITY nodes.
  origin         String     @default("SEED")
  order          Int        @default(0)
  createdAt      DateTime   @default(now())
  edgesFrom      Edge[]     @relation("EdgeFrom")
  edgesTo        Edge[]     @relation("EdgeTo")
  coverage       Coverage[]
  holdings       Holding[]
  claims         Claim[]
  questions      Question[]
  quizzes        Quiz[]
  stakes         Stake[]
  expansionsAsParent Expansion[]
  communitySources   CommunitySource[]
}

/// A typed relation between nodes. There is no prerequisite type; ordering is
/// advisory, never enforced.
model Edge {
  id     String   @id @default(cuid())
  fromId String
  from   Node     @relation("EdgeFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId   String
  to     Node     @relation("EdgeTo", fields: [toId], references: [id], onDelete: Cascade)
  kind   EdgeKind @default(ADJACENT)
  weight Float    @default(1)

  @@unique([fromId, toId, kind])
}

/// Which resource covers which node, and how deeply.
///
/// This replaces the old one-module-per-node welding. A node is covered by many
/// resources and a resource covers many nodes, each at a stated depth. Only
/// DEFINES and DEMONSTRATES provisionally hold a node when the resource is
/// ticked — MENTIONS never does, so watching an eight-minute orientation cannot
/// hand you ground you never took.
model Coverage {
  id         String         @id @default(cuid())
  nodeId     String
  node       Node           @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  resourceId String
  resource   Resource       @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  depth      CoverageDepth  @default(MENTIONS)
  /// Why this row exists. For SEED rows a curator's note; for MACHINE/HUMAN rows
  /// a verbatim transcript span, verified to appear in the transcript.
  evidence   String         @default("")
  /// Offset into the resource where the evidence sits, when known.
  startSec   Int?
  source     CoverageSource @default(SEED)
  confidence Float?
  reviewedAt DateTime?
  order      Int            @default(0)

  @@unique([nodeId, resourceId])
  @@index([resourceId, depth])
}

/// A user's relation to a node. Frontier is NOT stored — it is derived on read
/// as the one-edge neighbours of held nodes, minus held and thin nodes.
model Holding {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  nodeId         String
  node           Node         @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  state          HoldingState @default(HELD)
  provisional    Boolean      @default(false)
  establishedAt  DateTime     @default(now())
  lastTouchedAt  DateTime     @default(now())
  thinCause      String       @default("")
  contentVersion Int          @default(1)

  stake          Stake?

  @@unique([userId, nodeId])
  @@index([nodeId])
}

/// An unsettled proposition attached to a node. Never resolved by the platform.
model Claim {
  id         String          @id @default(cuid())
  nodeId     String
  node       Node            @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  text       String
  openedById String?
  openedBy   User?           @relation(fields: [openedById], references: [id], onDelete: SetNull)
  state      ClaimState      @default(OPEN)
  createdAt  DateTime        @default(now())
  positions  ClaimPosition[]

  @@index([nodeId])
}

model ClaimPosition {
  id        String   @id @default(cuid())
  claimId   String
  claim     Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stance    Stance
  statement String   @default("")
  createdAt DateTime @default(now())

  @@unique([claimId, userId])
}

/// Audit trail for consent to social features: what the user agreed to or
/// withdrew, when, and under which version of the policy text. Deleted with the
/// user.
model ConsentRecord {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose       String   @default("SOCIAL")
  granted       Boolean
  policyVersion String
  createdAt     DateTime @default(now())

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Social Q&A (opt-in). All of it is deleted when the author opts out or deletes
// their account — never anonymised.
// ─────────────────────────────────────────────────────────────────────────────

/// UNSURE = the AI could not decide; it has no effect on holdings.
enum Verdict {
  CORRECT
  INCORRECT
  UNSURE
}

enum ReviewOutcome {
  UPHELD
  OVERTURNED
}

model Question {
  id        String   @id @default(cuid())
  nodeId    String
  node      Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  text      String
  /// AI-written reference answer, always shown labelled as AI-generated.
  aiAnswer  String   @default("")
  createdAt DateTime @default(now())
  hiddenAt  DateTime?
  /// "ADMIN" or "AUTO" (three reports); empty when visible.
  hiddenBy  String   @default("")
  answers   Answer[]
  votes     Vote[]
  reports   Report[]

  @@index([nodeId])
}

model Answer {
  id         String         @id @default(cuid())
  questionId String
  question   Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  authorId   String
  author     User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  text       String
  /// null = not judged yet (for example the AI was unavailable).
  verdict    Verdict?
  aiReason   String         @default("")
  judgedAt   DateTime?
  createdAt  DateTime       @default(now())
  hiddenAt   DateTime?
  hiddenBy   String         @default("")
  votes      Vote[]
  reviews    AnswerReview[]
  appeal     AnswerAppeal?
  reports    Report[]

  @@index([questionId])
}

/// One vote per user per question or answer. value is +1 or -1.
model Vote {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String?
  question   Question? @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answerId   String?
  answer     Answer?   @relation(fields: [answerId], references: [id], onDelete: Cascade)
  value      Int
  createdAt  DateTime  @default(now())

  @@unique([userId, questionId])
  @@unique([userId, answerId])
}

/// A user's challenge to an AI judgement. Re-assessed once by the AI; the
/// outcome is final, which also bounds the cost of challenges.
model AnswerReview {
  id          String        @id @default(cuid())
  answerId    String        @unique
  answer      Answer        @relation(fields: [answerId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  explanation String
  outcome     ReviewOutcome
  aiReason    String        @default("")
  createdAt   DateTime      @default(now())
}

// ─────────────────────────────────────────────────────────────────────────────
// Social quizzes (opt-in): three AI-written multiple-choice questions per quiz.
// ─────────────────────────────────────────────────────────────────────────────

enum QuizReviewOutcome {
  UPHELD
  KEY_FIXED
  VOIDED
}

model Quiz {
  id        String         @id @default(cuid())
  nodeId    String
  node      Node           @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  authorId  String
  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  /// Optional steer from the creator ("focus on data privacy").
  focus     String         @default("")
  createdAt DateTime       @default(now())
  hiddenAt  DateTime?
  hiddenBy  String         @default("")
  reports   Report[]
  questions QuizQuestion[]
  attempts  QuizAttempt[]
  ratings   QuizRating[]

  @@index([nodeId])
}

model QuizQuestion {
  id           String              @id @default(cuid())
  quizId       String
  quiz         Quiz                @relation(fields: [quizId], references: [id], onDelete: Cascade)
  position     Int
  text         String
  options      String[]
  correctIndex Int
  explanation  String              @default("")
  /// Voided questions are not counted in grading from then on.
  voided       Boolean             @default(false)
  review       QuizQuestionReview?
  appeals      QuizQuestionAppeal[]
}

/// One attempt per user per quiz. Passing holds the node; failing thins it.
model QuizAttempt {
  id        String   @id @default(cuid())
  quizId    String
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers   Int[]
  correct   Int
  total     Int
  passed    Boolean
  createdAt DateTime @default(now())

  @@unique([quizId, userId])
}

/// Rated by people who passed the quiz. value is +1 or -1.
model QuizRating {
  id        String   @id @default(cuid())
  quizId    String
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  value     Int
  createdAt DateTime @default(now())

  @@unique([quizId, userId])
}

/// A user's challenge to a quiz question's answer key. The AI re-checks it once;
/// that outcome is final.
model QuizQuestionReview {
  id          String            @id @default(cuid())
  questionId  String            @unique
  question    QuizQuestion      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  explanation String
  outcome     QuizReviewOutcome
  aiReason    String            @default("")
  createdAt   DateTime          @default(now())
}

// ─────────────────────────────────────────────────────────────────────────────
// Staking (opt-in): an explicit claim of expertise on one node.
// ─────────────────────────────────────────────────────────────────────────────

/// A staked node does not thin (no decay, no quiz-fail thinning). The stake hangs
/// off the holding, so it cannot outlive it. Points are never stored: they are
/// computed on demand from the underlying activity and are not shown to users.
model Stake {
  id        String   @id @default(cuid())
  holdingId String   @unique
  holding   Holding  @relation(fields: [holdingId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nodeId    String
  node      Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, nodeId])
  @@index([nodeId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Graph expansion (stakers only): a free source plus a new node name.
// ─────────────────────────────────────────────────────────────────────────────

enum ExpansionStatus {
  PUBLISHED
  PENDING
  REJECTED
}

/// A staker's suggestion. The record links the suggestion to its author and is
/// deleted with them. A node it published is not: the node is AI-written shared
/// graph content, so it carries no link back to the person.
model Expansion {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentNodeId String
  parent       Node            @relation(fields: [parentNodeId], references: [id], onDelete: Cascade)
  sourceUrl    String
  nodeTitle    String
  status       ExpansionStatus
  /// "AI" or "ADMIN"; empty while pending.
  decidedBy    String          @default("")
  reason       String          @default("")
  /// What the checks found (free access, relevance, uniqueness, qualification).
  report       Json?
  /// The node the AI drafted, kept so an admin can approve it as written.
  draft        Json?
  /// Plain id, no foreign key: the node outlives this record.
  createdNodeId String?
  createdAt    DateTime        @default(now())
  decidedAt    DateTime?

  @@index([status])
  @@index([userId])
}

/// A free source attached to a community-added node.
model CommunitySource {
  id        String   @id @default(cuid())
  nodeId    String
  node      Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  url       String
  title     String   @default("")
  createdAt DateTime @default(now())

  @@index([nodeId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Password reset, moderation reports, resource ratings.
// ─────────────────────────────────────────────────────────────────────────────

/// A single-use, time-limited password reset. Only a hash of the token is stored.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum ReportReason {
  ABUSE
  SPAM
  OFF_TOPIC
  PERSONAL_DATA
  OTHER
}

enum ReportStatus {
  OPEN
  DISMISSED
  ACTIONED
}

/// A user's report of a post. Exactly one of questionId, answerId, quizId is set.
/// Reports die with the post. Three distinct open reports hide the post until an
/// admin decides.
model Report {
  id         String       @id @default(cuid())
  reporterId String
  reporter   User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  questionId String?
  question   Question?    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answerId   String?
  answer     Answer?      @relation(fields: [answerId], references: [id], onDelete: Cascade)
  quizId     String?
  quiz       Quiz?        @relation(fields: [quizId], references: [id], onDelete: Cascade)
  reason     ReportReason
  note       String       @default("")
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())
  decidedAt  DateTime?

  @@unique([reporterId, questionId])
  @@unique([reporterId, answerId])
  @@unique([reporterId, quizId])
  @@index([status])
}

/// A thumbs up or down (+1 / -1) on a resource, from someone with a verified hold
/// on a node it covers. The user's own vote is shown to them; admins see totals.
model ResourceVote {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  value      Int
  createdAt  DateTime @default(now())

  @@unique([userId, resourceId])
  @@index([resourceId])
}


/// Fixed-window request counter for throttling auth endpoints. One row per
/// key (e.g. "login:ip:1.2.3.4"); shared across instances and restarts.
model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime
}

// ─────────────────────────────────────────────────────────────────────────────
// Appeals. The AI re-checks a challenge once; if the person still disagrees they
// can ask an admin. Seen only by the person who appealed, and by admins.
// ─────────────────────────────────────────────────────────────────────────────

enum AppealStatus {
  OPEN
  UPHELD      // the original judgement stands
  OVERTURNED  // an admin sided with the person
}

/// An appeal against an answer's AI judgement, after the AI's one re-check. Author only.
model AnswerAppeal {
  id          String       @id @default(cuid())
  answerId    String       @unique
  answer      Answer       @relation(fields: [answerId], references: [id], onDelete: Cascade)
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  explanation String
  status      AppealStatus @default(OPEN)
  adminNote   String       @default("")
  decidedAt   DateTime?
  createdAt   DateTime     @default(now())

  @@index([status])
}

/// An appeal against a quiz answer key by someone who took the quiz and got that question wrong.
model QuizQuestionAppeal {
  id          String             @id @default(cuid())
  questionId  String
  question    QuizQuestion       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  explanation String
  status      AppealStatus       @default(OPEN)
  /// What an admin did to the question when they overturned: KEY_FIXED or VOIDED.
  resolution  QuizReviewOutcome?
  adminNote   String             @default("")
  decidedAt   DateTime?
  createdAt   DateTime           @default(now())

  @@unique([questionId, userId])
  @@index([status])
}

/// Explicit old-key to new-key mapping for content that is renamed, merged, retired or
/// orphaned by a refactor. Rows are never deleted: old links resolve through them, and
/// they are the record of what happened to a duplicate or orphan.
model ContentMapping {
  id        String   @id @default(cuid())
  /// MODULE (by code), NODE (by slug), RESOURCE (by id).
  kind      String
  fromKey   String
  /// Null when the content was retired with no successor.
  toKey     String?
  /// RENAMED, MERGED, RETIRED, ORPHANED.
  status    String
  note      String   @default("")
  createdAt DateTime @default(now())

  @@unique([kind, fromKey])
}

/// A learner's worksheet answers, saved to the account only when they choose to. Until
/// then answers live in the browser (see ExerciseWorkspace) and this table has no row.
/// Keys inside `values` are the worksheet's field ids, validated on write.
model WorksheetEntry {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseCode String
  values       Json     @default("{}")
  days         Json     @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, exerciseCode])
}
