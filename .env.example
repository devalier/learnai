# These are set in the server environment by the admin — never commit real values.
# .env is gitignored; this file only documents which variables the app expects.

# Postgres connection string (provided by the server/db admin).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/learnai"

# Secret used to sign session JWTs. A long random string, set on the server.
AUTH_SECRET="set-a-long-random-secret-on-the-server"

# First admin bootstrap, used once by prisma/seed.ts.
ADMIN_EMAIL="paul.devalier@gmail.com"
ADMIN_PASSWORD="set-a-strong-password"
ADMIN_NAME="Paul"

# Shared secret for the nightly holdings-decay job (POST /api/jobs/decay).
# Optional in dev; required to run the decay endpoint. Long random string.
JOB_SECRET="set-a-long-random-secret-for-cron"

# AI for the social features (question screening, answer judging): Mistral AI only.
# Plain REST, no SDK. The model is read on every request, so it can be changed
# without a deploy of new code. MISTRAL_API_KEY must be set on the server.
# MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest
