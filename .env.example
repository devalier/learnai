# SQLite by default. For production (Postgres) set e.g.
# DATABASE_URL="postgresql://user:pass@host:5432/learnai"
# and change datasource provider in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.db"

# Secret used to sign session JWTs. MUST be set to a long random string in production.
AUTH_SECRET="change-me-to-a-long-random-secret-string"

# First admin bootstrap (used by prisma/seed.ts)
ADMIN_EMAIL="paul.devalier@gmail.com"
ADMIN_PASSWORD="changeme123"
ADMIN_NAME="Paul"
