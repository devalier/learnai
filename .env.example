# Every variable the app reads. Real values live in the server's environment (or its
# secret manager), never in this repository. `.env` is gitignored; this file is a list
# of names with placeholders only. In production the server refuses to start with a
# missing or weak AUTH_SECRET (see src/lib/startup.ts).

# ── Required ─────────────────────────────────────────────────────────────────

# Postgres connection string. Needed at build time as well as run time (the build
# applies the schema). Add ?sslmode=require for a remote database, and e.g.
# &connection_limit=10 to cap this process's pool.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/learnai"

# Signs session cookies. At least 32 random characters, e.g. `openssl rand -base64 48`.
# Also keys the hashes in the rate-limit table. Changing it signs everyone out.
AUTH_SECRET=""

# Public base URL, no trailing slash. Used in emailed links and in the cross-site
# request check. If it is wrong, real form posts fail with 403.
APP_URL="https://learnai.example.com"

# ── Optional ─────────────────────────────────────────────────────────────────

# Shared secret for the nightly job: POST /api/jobs/decay with header x-job-secret.
# Without it the endpoint is disabled. `openssl rand -base64 32`.
JOB_SECRET=""

# Outgoing email (password resets). Without SMTP_HOST, reset emails cannot be sent.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false          # "true" for implicit TLS on port 465
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="learnai <no-reply@example.com>"

# AI for the social features (Mistral AI only). Without a key the AI is "unavailable":
# questions are accepted unanswered, answers are not judged, quizzes cannot be made.
# MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest

# "off" sends every community-suggested node to the admin queue instead of publishing
# it on the AI's say-so.
# GRAPH_EXPANSION_AUTO=off

# "1" makes the Content-Security-Policy report-only (an emergency lever, not a setting).
# CSP_REPORT_ONLY=

# debug | info | warn | error. Default info.
# LOG_LEVEL=info

# ── Only when seeding (`npm run db:seed`) ────────────────────────────────────
# The seed creates the first admin and stops with an error if these are missing.
# Set them for that command only; do not leave them in the running service's
# environment.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=
# ADMIN_NAME=Admin
